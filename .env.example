# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Get this from: MongoDB Atlas → Your Cluster → Connect → Drivers → Node.js
MONGODB_URI="mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/mealtracker?retryWrites=true&w=majority"

# App URL (auto-injected by Vercel in production, used for self-referential links)
APP_URL="http://localhost:3001"
